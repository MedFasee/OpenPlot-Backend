# ============================================================
# OPENPLOT - PRODUCAO / PERFIL ONS
#
# Deploy:
# docker compose --env-file .env.prod up -d --build --force-recreate
#
# Este arquivo contem segredos e deve permanecer no .gitignore.
# ============================================================

# ============================================================
# DOCKER COMPOSE / BUILD
# ============================================================

COMPOSE_PROJECT_NAME=openplot-prod
OPENPLOT_ENV_FILE=.env.prod
OPENPLOT_VERSION=1.0.0

OPENPLOT_NUGET_CONFIG=NuGet.config
OPENPLOT_ENABLE_ONS_CONFIGIT=true

OPENPLOT_API_PORT=17011
OPENPLOT_DATA_ROOT=/srv/openplot/prod


# ============================================================
# ASP.NET / API
# ============================================================

ASPNETCORE_ENVIRONMENT=Production

Auth__UseMock=false
AuthProvider__Provider=Ons

Swagger__Enabled=false
RequestLogging__IncludeRequestBody=false


# ============================================================
# BANCO EXTERNO
#
# A mesma ConnectionStrings__Db e lida pela API, ExportWorker
# e pelo Ingestor. Nenhum banco e criado pelo Docker.
# ============================================================

ConnectionStrings__Db='Host=ydrmkeftlc.upkcvavk1z.privatelink.cloud.tigerdata.com;Port=5432;Database=tsdb;Username=servicedopenplot;Password=Zxolgm370$;Search Path=openplot,public;SSL Mode=Require'


# ============================================================
# JWT INTERNO
# ============================================================

Jwt__Issuer=openplot-prod
Jwt__Audience=openplot-spa
Jwt__SigningKey=EBMRBkRnbvybzxtl1nwJiBtDfyIKXT9NuPdZdltWDdy
Jwt__ExpirationHours=24


# ============================================================
# AUTENTICACAO DEFINITIVA ONS / KEYCLOAK
# ============================================================

ExternalJwtProviders__0__AuthenticationScheme=OnsKeycloak
ExternalJwtProviders__0__Enabled=true
ExternalJwtProviders__0__Authority=https://ssotst.ons.org.br/auth/realms/ONS/
ExternalJwtProviders__0__Audience=OpenPlot
ExternalJwtProviders__0__ValidIssuer=https://ssotst.ons.org.br/auth/realms/ONS
ExternalJwtProviders__0__RequireHttpsMetadata=true
ExternalJwtProviders__0__SaveToken=false
ExternalJwtProviders__0__IncludeErrorDetails=false
ExternalJwtProviders__0__ClockSkewMinutes=2
ExternalJwtProviders__0__NameClaimType=preferred_username
ExternalJwtProviders__0__RoleClaimType=roles


# ============================================================
# SSO
# ============================================================

Sso__FrontendBaseUrl=http://localhost:5173
Sso__ConsumePath=/sso/consumir
Sso__RedirectPathTemplate=/processar-busca?consultaId={consultaId}
Sso__RequestTtlSeconds=300
Sso__LoginTokenTtlSeconds=120

# O ClientId multiinfeed antigo possuia apenas um secret placeholder
# ("change-me-in-production"). Por isso ele NAO e configurado aqui
# ate que exista o secret real.


# ============================================================
# CORS PROD
# Somente as origens explicitamente autorizadas.
# ============================================================

Cors__AllowAnyOrigin=false
Cors__AllowCredentials=true
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=https://unacerbic-clarine-machinely.ngrok-free.dev


# ============================================================
# CONFIGIT
# ============================================================

ConfigIT_ENABLED=true
ConfigITr=https://configit-api.ons.org.br
ConfigITapiKey=72183c66-8431-4051-b0a6-efe1a525baec
ConfigITamb=Teste
ConfigITpacote=OpenPlot
ConfigITjsonFullPath=/app/configit.json


# ============================================================
# OPENTELEMETRY
#
# O endpoint abaixo ainda e o collector DEV/TST atualmente usado.
# ============================================================

OTEL_ENABLED=true
OTEL_SERVICE_NAME=openplot-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector-http-ons-coletor.apps.rosa.rosa-dev.wmaj.p3.openshiftapps.com
OTEL_EXPORTER_OTLP_PROTOCOL=grpc


# ============================================================
# INGESTOR
# ============================================================

OPENPLOT_INGESTOR__PollIntervalSeconds=4
OPENPLOT_INGESTOR__ChunkMinutes=5
OPENPLOT_INGESTOR__MaxParallelChunks=4
OPENPLOT_INGESTOR__MaxParallelJobs=4
OPENPLOT_INGESTOR__GlobalMaxParallelChunks=4


Exports__MaxParallelJobs=2
Exports__MaxCpuUsagePercent=75
Exports__PollIntervalMs=2000
Exports__MeasurementsQueryTimeoutSeconds=180