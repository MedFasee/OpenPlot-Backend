COMPOSE_PROJECT_NAME=openplot-prod
OPENPLOT_VERSION=1.0.0
OPENPLOT_POSTGRES_DB=postgres
OPENPLOT_POSTGRES_USER=postgres
OPENPLOT_POSTGRES_PASSWORD=postgres
OPENPLOT_POSTGRES_RESTORE_DUMP=true
OPENPLOT_POSTGRES_PORT=15432
OPENPLOT_API_PORT=17011
OPENPLOT_API_ENVIRONMENT=Production
OPENPLOT_AUTH_PROVIDER=Ons
ConfigIT_ENABLED=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=openplot-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OPENPLOT_DATA_ROOT=/srv/openplot/prod
OPENPLOT_API_IMAGE=openplot-api:1.0.0
OPENPLOT_INGESTOR_IMAGE=openplot-ingestor-gsf:1.0.0
OPENPLOT_EXPORT_WORKER_IMAGE=openplot-export-worker:1.0.0
OPENPLOT_EMBED_XMLIMPORTER_ENABLED=true
OPENPLOT_EMBED_EXPORT_WORKER_ENABLED=true
OPENPLOT_XMLIMPORTER_RUN_ON_STARTUP=true
OPENPLOT_XMLIMPORTER_POLL_SECONDS=0
OPENPLOT_INGESTOR_POLL_SECONDS=2
OPENPLOT_INGESTOR_CHUNK_MINUTES=10
OPENPLOT_INGESTOR_MAX_PARALLEL_CHUNKS=2
OPENPLOT_INGESTOR_MAX_PARALLEL_JOBS=2
OPENPLOT_INGESTOR_GLOBAL_MAX_PARALLEL_CHUNKS=4
