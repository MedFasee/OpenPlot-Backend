{
  "Auth": {
    "UseMock": true,
    "UserStore": {
      "UsersPath": "Auth/users.local.json"
    }
  },
  "AuthProvider": {
    "Provider": "OpenPlot"
  },
  "Jwt": {
    "Issuer": "openplot-dev",
    "Audience": "openplot-spa",
    "SigningKey": "",
    "ExpirationHours": 24
  },
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowCredentials": true,
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "RequestLogging": {
    "Enabled": false,
    "IncludeRequestBody": false
  },
  "ExternalJwtProviders": []
}
