{
  "Auth": {
    "UseMock": true,
    "UserStore": {
      "UsersPath": "Auth/users.local.json"
    }
  },
  "AuthProvider": {
    "Provider": "OpenPlot"
  },
  "Jwt": {
    "Issuer": "openplot-auth",
    "Audience": "openplot-apis",
    "SigningKey": "",
    "ExpirationHours": 24,
    "CookieName": "AuthToken"
  },
  "Sso": {
    "FrontendBaseUrl": "http://localhost:5173",
    "ConsumePath": "/sso/consumir",
    "RedirectPathTemplate": "/processar-busca?consultaId={consultaId}",
    "RequestTtlSeconds": 300,
    "LoginTokenTtlSeconds": 120
  },
  "SsoClients": [],
  "ExternalJwtProviders": [],
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowCredentials": true,
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "Db": ""
  },
  "RequestLogging": {
    "Enabled": false,
    "IncludeRequestBody": false,
    "MaxRequestBodyBytes": 10240
  },
  "Swagger": {
    "Enabled": false
  },
  "OTEL_ENABLED": false,
  "OTEL_SERVICE_NAME": "openplot-api",
  "OTEL_SERVICE_VERSION": "1.0.0",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
  "XmlFolder": "",
  "AllowedHosts": "*"
}
