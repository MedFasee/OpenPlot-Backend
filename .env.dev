COMPOSE_PROJECT_NAME=openplot-dev
OPENPLOT_VERSION=dev
OPENPLOT_POSTGRES_DB=postgres
OPENPLOT_POSTGRES_USER=postgres
OPENPLOT_POSTGRES_PASSWORD=postgres
OPENPLOT_POSTGRES_PORT=5432
OPENPLOT_API_PORT=7011
OPENPLOT_API_ENVIRONMENT=Development
OPENPLOT_AUTH_PROVIDER=OpenPlot
ConfigIT_ENABLED=false
ConfigITr=https://configit-api.ons.org.br
ConfigITapiKey=a
ConfigITamb=Teste
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector-http-ons-coletor.apps.rosa.rosa-dev.wmaj.p3.openshiftapps.com
OTEL_ENABLED=true
OTEL_SERVICE_NAME=openplot-api
OTEL_SERVICE_VERSION=dev
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
ConfigITpacote=OpenPlot
OPENPLOT_DATA_ROOT=/srv/openplot/dev
OPENPLOT_API_IMAGE=openplot-api:dev
OPENPLOT_INGESTOR_IMAGE=openplot-ingestor-gsf:dev
OPENPLOT_EXPORT_WORKER_IMAGE=openplot-export-worker:dev
OPENPLOT_EMBED_XMLIMPORTER_ENABLED=true
OPENPLOT_EMBED_EXPORT_WORKER_ENABLED=true
OPENPLOT_XMLIMPORTER_RUN_ON_STARTUP=true
OPENPLOT_XMLIMPORTER_POLL_SECONDS=0
OPENPLOT_INGESTOR_POLL_SECONDS=2
OPENPLOT_INGESTOR_CHUNK_MINUTES=10
OPENPLOT_INGESTOR_MAX_PARALLEL_CHUNKS=2
OPENPLOT_INGESTOR_MAX_PARALLEL_JOBS=2
OPENPLOT_INGESTOR_GLOBAL_MAX_PARALLEL_CHUNKS=4
