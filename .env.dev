# ============================================================
# OPENPLOT - DESENVOLVIMENTO
#
# Deploy:
# docker compose --env-file .env.dev up -d --build --force-recreate
#
# Este arquivo contem segredos e deve permanecer no .gitignore.
# ============================================================

# ============================================================
# DOCKER COMPOSE / BUILD
# ============================================================

COMPOSE_PROJECT_NAME=openplot-dev
OPENPLOT_ENV_FILE=.env.dev
OPENPLOT_VERSION=dev

OPENPLOT_NUGET_CONFIG=NuGet.dev.config
OPENPLOT_ENABLE_ONS_CONFIGIT=false

OPENPLOT_API_PORT=7011
OPENPLOT_DATA_ROOT=./data


# ============================================================
# ASP.NET / API
# ============================================================

ASPNETCORE_ENVIRONMENT=Development

Auth__UseMock=true
AuthProvider__Provider=OpenPlot
Auth__UserStore__UsersPath=Auth/users.json

Jwt__Issuer=openplot-dev
Jwt__Audience=openplot-spa
Jwt__SigningKey=XS9KOPZ7n-AbrcYC0PPLzjDdfZyEAA2D5D6sY0eXZjzEu43nc_zqxBmb2YzvWknE
Jwt__ExpirationHours=24

Swagger__Enabled=true
RequestLogging__IncludeRequestBody=false


# ============================================================
# BANCO EXTERNO
#
# A mesma ConnectionStrings__Db e lida pela API, ExportWorker
# e pelo Ingestor. Nenhum banco e criado pelo Docker.
# ============================================================

ConnectionStrings__Db='Host=host.docker.internal;Port=5432;Database=postgres;Username=postgres;Password=postgres;Search Path=openplot'


# ============================================================
# CORS DEV
# Qualquer origem pode chamar a API.
# A autenticacao continua obrigatoria nos endpoints protegidos.
# ============================================================

Cors__AllowAnyOrigin=true
Cors__AllowCredentials=false


# ============================================================
# CONFIGIT
# ============================================================

ConfigIT_ENABLED=false
ConfigITr=https://configit-api.ons.org.br
ConfigITamb=Teste
ConfigITpacote=OpenPlot


# ============================================================
# OPENTELEMETRY
# ============================================================

OTEL_ENABLED=true
OTEL_SERVICE_NAME=openplot-api
OTEL_SERVICE_VERSION=dev
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector-http-ons-coletor.apps.rosa.rosa-dev.wmaj.p3.openshiftapps.com
OTEL_EXPORTER_OTLP_PROTOCOL=grpc


# ============================================================
# INGESTOR
# ============================================================

OPENPLOT_INGESTOR__PollIntervalSeconds=2
OPENPLOT_INGESTOR__ChunkMinutes=5
OPENPLOT_INGESTOR__MaxParallelChunks=2
OPENPLOT_INGESTOR__MaxParallelJobs=2
OPENPLOT_INGESTOR__GlobalMaxParallelChunks=1
