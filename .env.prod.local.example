# Copie este arquivo para .env.prod.local (nao versionado) e preencha os segredos reais.
# O comando de subida em prod deve usar .env.prod + .env.prod.local

ConfigITr=https://configit-api.ons.org.br
ConfigITapiKey=change-me
ConfigITamb=Producao
ConfigITpacote=OpenPlot
ConfigITjsonFullPath=/app/configit.json
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector-http-ons-coletor.apps.rosa.rosa-dev.wmaj.p3.openshiftapps.com
OTEL_ENABLED=true
OTEL_SERVICE_NAME=openplot-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Opcional: preencher quando estiver em rede corporativa com proxy
# HTTP_PROXY=http://proxy.seudominio:8080
# HTTPS_PROXY=http://proxy.seudominio:8080
# NO_PROXY=localhost,127.0.0.1,postgres,openplot-api

# Opcional: tuning dos workers e serviços auxiliares
# OPENPLOT_INGESTOR_IMAGE=openplot-ingestor-gsf:1.0.0
# OPENPLOT_EMBED_XMLIMPORTER_ENABLED=true
# OPENPLOT_EMBED_EXPORT_WORKER_ENABLED=true
# OPENPLOT_XMLIMPORTER_RUN_ON_STARTUP=true
# OPENPLOT_XMLIMPORTER_POLL_SECONDS=0
# OPENPLOT_INGESTOR_POLL_SECONDS=2
# OPENPLOT_INGESTOR_CHUNK_MINUTES=10
# OPENPLOT_INGESTOR_MAX_PARALLEL_CHUNKS=2
# OPENPLOT_INGESTOR_MAX_PARALLEL_JOBS=2
# OPENPLOT_INGESTOR_GLOBAL_MAX_PARALLEL_CHUNKS=4
