<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Banco é externo. Defina OPENPLOT_INGESTOR__DB no ambiente/secret store. -->
    <add key="PollIntervalSeconds" value="2" />
    <add key="ChunkMinutes" value="1" />
    <add key="MaxParallelChunks" value="2" />
    <add key="MaxParallelJobs" value="2" />
    <add key="GlobalMaxParallelChunks" value="4" />
    <add key="SourceTimeKind" value="Local" />
  </appSettings>
</configuration>
